# =============================================
# OpenClaw - Variables de Configuracion
# =============================================
# Copia este archivo como .env y completa tus datos:
#   cp .env.example .env

# Tu API Key de Anthropic (Claude)
# Obtenla en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-tu-clave-aqui

# Token del gateway (se genera automaticamente con el setup)
OPENCLAW_GATEWAY_TOKEN=

# Zona horaria (ajusta segun tu ubicacion)
TZ=America/Bogota

# Imagen de Docker (dejar por defecto para usar la oficial)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
