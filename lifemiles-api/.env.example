# --- Credenciales LifeMiles (tu propia cuenta) ---
# Se usan solo para autenticar la búsqueda de disponibilidad.
LIFEMILES_USERNAME=
LIFEMILES_PASSWORD=

# --- Endpoint de búsqueda ---
# LifeMiles no publica una API oficial. Estos valores describen la
# request real que hace su sitio al buscar premios (redención de millas),
# capturada del buscador. Ver capture/samples/ para un ejemplo completo.
LIFEMILES_BASE_URL=https://api.lifemiles.com
LIFEMILES_SEARCH_PATH=/svc/air-redemption-find-flight-private
LIFEMILES_REALM=lifemiles
LIFEMILES_LANGUAGE=es
LIFEMILES_COUNTRY=co
LIFEMILES_CURRENCY=COP
# Opcional: idCoti de una sesión web, solo si el server lo exige.
LIFEMILES_ID_COTI=

# Bearer JWT del SSO de LifeMiles (Keycloak). OJO: vive solo unos MINUTOS.
# Override MANUAL para una corrida puntual: pegá un token fresco copiado de
# las DevTools (Network -> request a api.lifemiles.com -> header
# Authorization, sin el prefijo "Bearer "). Para monitoreo autónomo dejá esto
# vacío y usá LIFEMILES_REFRESH_TOKEN (ver abajo).
LIFEMILES_API_KEY=

# --- Renovación automática de token (recomendado para modo live autónomo) ---
# El cliente renueva el access token solo contra el SSO (Keycloak) en cada
# ciclo, usando un refresh token. Ver app/auth.py y README.
#
# Cómo obtener el refresh token (una sola vez, login manual en TU navegador):
#   1. lifemiles.com -> logueate.
#   2. F12 -> Network -> filtrá por "token".
#   3. Buscá la request a .../openid-connect/token; en su respuesta JSON está
#      "refresh_token". Copialo acá (idealmente uno con scope offline_access
#      para que dure meses; ver README).
LIFEMILES_REFRESH_TOKEN=
# Endpoint y cliente del SSO (defaults verificados; no suele hacer falta tocar).
LIFEMILES_TOKEN_URL=https://sso.lifemiles.com/auth/realms/lifemiles/protocol/openid-connect/token
LIFEMILES_CLIENT_ID=lm-prd
LIFEMILES_SCOPE=openid
# Archivo donde se guarda el refresh token rotado (gitignoreado).
LIFEMILES_TOKEN_CACHE=.lifemiles_token.json

# --- Modo de ejecución ---
# mock  -> usa datos simulados, no toca la red (para probar el pipeline)
# live  -> pega contra el endpoint real configurado arriba
LIFEMILES_MODE=mock

# --- Alertas ---
# Webhook opcional (Slack/Discord/Telegram-bridge/n8n). Vacío = solo log + API.
ALERT_WEBHOOK_URL=

# --- Servidor API ---
API_HOST=127.0.0.1
API_PORT=8000
