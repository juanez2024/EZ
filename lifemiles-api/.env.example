# --- Credenciales LifeMiles (tu propia cuenta) ---
# Se usan solo para autenticar la búsqueda de disponibilidad.
LIFEMILES_USERNAME=
LIFEMILES_PASSWORD=

# --- Endpoint de búsqueda ---
# LifeMiles no publica una API oficial. Estos valores describen la
# request que hace su propio sitio al buscar premios. Debés capturarlos
# desde las DevTools del navegador (pestaña Network) y pegarlos acá.
# Ver README -> "Capturar el endpoint real".
LIFEMILES_BASE_URL=https://api.lifemiles.com
LIFEMILES_SEARCH_PATH=/v1/availability/search
LIFEMILES_API_KEY=

# --- Modo de ejecución ---
# mock  -> usa datos simulados, no toca la red (para probar el pipeline)
# live  -> pega contra el endpoint real configurado arriba
LIFEMILES_MODE=mock

# --- Alertas ---
# Webhook opcional (Slack/Discord/Telegram-bridge/n8n). Vacío = solo log + API.
ALERT_WEBHOOK_URL=

# --- Servidor API ---
API_HOST=127.0.0.1
API_PORT=8000
